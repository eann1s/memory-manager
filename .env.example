# APP
HTTP_PORT=:8080

# DB
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=postgres

# DB (optional alternative - overrides individual DB_* vars)
# DB_URL=postgres://user:pass@host:5432/dbname

# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_TIMEOUT=30
EMBEDDING_DIM=1536

# Memory Manager
MEMORY_IMPORTANCE_THRESHOLD=0.3
MEMORY_MAX_CONTENT_LEN=10000
WRITE_MAX_ITEMS=100
